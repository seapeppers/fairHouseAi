# Copy to .env (never commit it). Real values are shared privately.

# Box OAuth app (developer.box.com > app > Configuration)
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_REDIRECT_URI=http://localhost:8000/auth/box/callback

# Folder IDs printed by scripts/box_setup.py
BOX_ROOT_FOLDER_ID=
BOX_RULES_FOLDER_ID=
BOX_REVIEWS_FOLDER_ID=
BOX_BUILDING_FOLDER_ID=

# box = real Box sign-in per user; demo = role buttons over one shared Box connection
AUTH_MODE=box
FRONTEND_URL=http://localhost:5173
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# IAM user fairhouse-app (Bedrock + Textract only)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5-5
