# Box CCG app in the FairHouse enterprise (named BOX_CCG_* so they never clash with the
# sign-in app's BOX_CLIENT_ID in the shared repo-root .env)
BOX_CCG_CLIENT_ID=
BOX_CCG_CLIENT_SECRET=
BOX_ENTERPRISE_ID=1559593925
BOX_USER_ID=
# Local runs only: a 60-minute developer token instead of the CCG app
BOX_DEVELOPER_TOKEN=
BOX_WEBHOOK_PRIMARY_KEY=
# Reviews / Agent results; must sit outside the folder the webhook watches
BOX_RESULTS_FOLDER_ID=428510046425
# Juniper Court Apartments, for `npm run check -- --all`
BOX_BUILDING_FOLDER_ID=428478539937
# Scratch folder for the e2e test (never a real household folder)
BOX_INPUTS_FOLDER_ID=428510674856
# Box AI model for extraction (Claude on AWS); Box's default is Gemini Flash Lite
BOX_AI_MODEL=aws__claude_4_5_sonnet
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
